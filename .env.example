# Copied to .env by ./setup.sh (Linux) or .\setup.ps1 (Windows), which fill in the secrets and paths.
# .env is per device and stays out of git.

# Hugin's API token (phone/desktop clients use it) and its web UI password
HUGIN_API_TOKEN=
HUGIN_UI_PASSWORD=

# The folder the agent may work in, and where it appears inside the container.
# Linux: the same path on both sides, so paths you type in the Agent tab match. Windows: /projects inside.
PROJECTS_DIR=
PROJECTS_MOUNT=/projects

# The host user the container runs as (Linux: `id -u` / `id -g`; Windows: leave 1000)
ECHO_UID=1000
ECHO_GID=1000

TZ=UTC

# Optional
# Read tab voice cloning: a Hugging Face read token (huggingface.co/settings/tokens) from an account that accepted
# the terms at huggingface.co/kyutai/pocket-tts. The default voices work without it.
# HF_TOKEN=
# ECHO_PORT=7777
# HUGIN_PORT=8088
# NTFY_PORT=8092
# HUGIN_LLM=qwen2.5:3b-instruct
# STT_MODEL_CPU=distil-large-v3
